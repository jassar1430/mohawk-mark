{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "Public and private user data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string", "description": "User short bio" },
        "socialX": { "type": "string", "description": "X (Twitter) handle" },
        "socialInsta": { "type": "string", "description": "Instagram handle" },
        "xp": { "type": "number", "description": "Total experience points" },
        "level": { "type": "number", "description": "User level" },
        "dailyQuest": {
          "type": "object",
          "properties": {
            "quest": { "$ref": "questItem" },
            "status": { "type": "string", "enum": ["available", "accepted", "completed"] },
            "refreshesRemaining": { "type": "number" },
            "lastRefreshDate": { "type": "string" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "questItem": {
      "title": "Quest Item",
      "description": "A single specific side quest task",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "location": { "type": "string" },
        "objective": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "xpReward": { "type": "number" }
      }
    },
    "quest": {
      "title": "Trip Quest",
      "description": "A saved trip with its side quests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "tripType": { "type": "string" },
        "createdAt": { "type": "string" },
        "quests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "location": { "type": "string" },
              "objective": { "type": "string" },
              "fits": { "type": "string" },
              "difficulty": { "type": "string" },
              "arabic": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "location": { "type": "string" },
                  "objective": { "type": "string" },
                  "fits": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "required": ["userId", "from", "to", "quests", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/users/{userId}/savedQuests/{questId}": {
      "schema": "quest",
      "description": "Historical quests generated by the user"
    },
    "/leaderboard/{userId}": {
      "schema": "user",
      "description": "Global leaderboard entries (subset of user profile)"
    }
  }
}
