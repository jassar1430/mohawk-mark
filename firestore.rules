rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      let requiredFields = ['uid', 'email', 'displayName', 'photoURL'];
      return data.keys().hasAll(requiredFields) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 1000;
    }

    function isValidUserStats(data) {
      return (!data.keys().contains('xp') || data.xp is number) &&
             (!data.keys().contains('level') || data.level is number) &&
             (!data.keys().contains('dailyQuest') || data.dailyQuest is map);
    }

    function isValidQuest(data) {
      return data.userId == request.auth.uid &&
             data.quests is list &&
             data.createdAt == request.time;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      
      // Saved Quests subcollection
      match /savedQuests/{questId} {
        allow list, get, create, delete: if isOwner(userId);
      }
    }

    // Leaderboard
    match /leaderboard/{userId} {
      allow list, get: if true;
      allow create, update: if isOwner(userId);
    }

    // Flight History
    match /flightHistory/{userId} {
      allow get, list: if isOwner(userId);
      match /records/{recordId} {
        allow get, list, create, update: if isOwner(userId);
      }
    }

    // Test connection
    match /test/connection {
      allow get: if true;
    }
  }
}
